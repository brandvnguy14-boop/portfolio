---
import Base from './Base.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';

interface Props {
  title: string;
  date: Date;
  type: 'essay' | 'poetry' | 'letter';
  dek?: string;
  slug: string;
}

const { title, date, type, dek, slug } = Astro.props;

const isLetter = type === 'letter';

// Letters carry only a month and year
const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: isLetter ? undefined : 'numeric',
  timeZone: 'UTC',
});
---

<Base title={`${title} — Brandon Nguyen`} description={dek}>
  <ReadingProgress />

  <article class:list={['post-wrap', { 'post-wrap--letter': isLetter }]}>
    <header class="post-header">
      <div class="post-meta">
        <time class="mono" datetime={date.toISOString()}>{formatted}</time>
        <span class="post-type mono" data-type={type}>{type}</span>
      </div>
      <h1 class="post-title" transition:name={`title-${slug}`}>{title}</h1>
      {dek && <p class="post-dek">{dek}</p>}
    </header>

    <div class:list={['prose', { 'prose-poetry': type === 'poetry', 'prose-letter': isLetter }]}>
      <slot />
    </div>

    {isLetter && <div class="letter-end" aria-hidden="true"></div>}

    <footer class="post-footer">
      <a href="/writing" class="back-link">
        <span class="mono">&#8592;</span> All writing
      </a>
    </footer>
  </article>
</Base>

<style>
  .post-wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem) 6rem;
  }

  .post-header {
    margin-bottom: 3.5rem;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    color: var(--color-text-muted);
  }

  .post-type {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .post-title {
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-variation-settings: 'opsz' 72;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 1rem;
  }

  .post-dek {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0;
    max-width: 55ch;
  }

  /* ── Letter: narrower measure, quieter header ─────────── */
  .post-wrap--letter {
    max-width: 34rem;
  }

  .post-wrap--letter .post-header {
    margin-bottom: 3rem;
  }

  .post-wrap--letter .post-title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-style: italic;
    font-weight: 350;
    letter-spacing: -0.015em;
  }

  .post-wrap--letter .post-header::after {
    content: '';
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-top: 2rem;
    background-color: var(--color-accent);
  }

  .letter-end {
    width: 5px;
    height: 5px;
    margin: 3.5rem auto 0;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .post-wrap--letter .post-footer {
    margin-top: 3.5rem;
  }

  .post-footer {
    margin-top: 5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-smooth);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .back-link:hover {
    color: var(--color-accent);
  }
</style>
