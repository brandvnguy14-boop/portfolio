---
import Base from '@/layouts/Base.astro';
---

<Base title="Small Apocalypses — Brandon Nguyen" description="A lexicon of endings and beginnings. Seven poems.">
  <div class="room" id="room">
    <a href="/writing" class="room-back mono">← Writing</a>
    <div class="book-wrap" id="book-wrap">
      <canvas id="book-canvas" aria-label="Small Apocalypses — a poetry collection by Brandon Nguyen"></canvas>
      <div class="dots-row" role="tablist" aria-label="Navigate spreads" id="dots-row"></div>
      <p class="flip-hint mono" id="flip-hint">drag corner · ← → to navigate</p>
    </div>
  </div>
</Base>

<style is:global>
.room {
  min-height: calc(100svh - 4rem);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 1.5rem clamp(1rem, 4vw, 3rem) 2.5rem;
  background: var(--color-bg);
  position: relative;
}

.room-back {
  position: absolute;
  top: 1.25rem;
  left: clamp(1rem, 4vw, 3rem);
  font-size: 0.7rem;
  letter-spacing: 0.06em;
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color var(--dur-fast) var(--ease-smooth);
  z-index: 10;
}
.room-back:hover { color: var(--color-accent); }

.book-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  animation: book-rise 0.6s var(--ease-enter) both;
  animation-delay: 0.08s;
}

@keyframes book-rise {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: translateY(0); }
}

#book-canvas {
  display: block;
  touch-action: none;
  cursor: default;
}

.dots-row {
  display: flex;
  gap: 0.5rem;
  align-items: center;
}
.dot {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--color-border-strong);
  border: none;
  padding: 0;
  cursor: pointer;
  transition: all var(--dur-fast) var(--ease-smooth);
}
.dot[aria-selected='true'] {
  background: var(--color-accent);
  transform: scale(1.35);
}

.flip-hint {
  font-size: 0.62rem;
  letter-spacing: 0.06em;
  color: var(--color-text-muted);
  margin: 0;
  opacity: 0.65;
  transition: opacity 0.4s;
}
</style>

<script>
import * as THREE from 'three';

// ── Poems data ───────────────────────────────────────────────────────────────
const C = {
  title: 'Small Apocalypses',
  subtitle: 'a lexicon of endings and beginnings',
  count: 'seven poems',
  preface: [
    'I have been preoccupied, for as long as I can remember, with what happens after something ceases to be. Not the cinematic kind, but the smaller afterlives that arrive without spectacle: the hum a room retains after the music stops, the way a voice keeps almost-arriving in the days after a funeral, the half-second of smoke after a candle is blown out, and the present tips, irretrievably, into the past.',
    'This collection is an attempt to build a small lexicon for those afterlives. Each poem takes a single word and tries to press it open. Language is our most beautiful failure. It cannot hold the dead. It cannot return the porch, the name no one calls anymore, the cowbell in the soldier\'s dream.',
    'But the dictionary is also a garden: every entry, a small refusal of forgetting. I wrote these poems in that double light—the world ending, the world beginning, and a word, somewhere in the middle, doing what it can.',
  ],
  poems: [
    { n:'I',   title:'Apocalypse', etym:'Greek apokalypsis: an uncovering, an unveiling',
      stanzas:['The world doesn\'t end all at once.\n\nIt ends in moments. The 2 a.m. silence\nthat feels less like quiet and more\nlike something listening back.\nThe sunset that holds on too long,\nas if the day knows what I do not.','I was eight the first time I believed.\nA live stream. An asteroid. The chicken\nsandwich on my plate became a stone.\nI asked my cousin, after church,\nif the world would end soon.\nNot for a million years, he said,\nif ever.','To a child, a million years\nis a synonym for tomorrow.','The Greek does not mean\ndestruction.\nIt means:\nto lift the veil.\nTo see, for one bright second,\nthe shape of a thing as it actually is.','Maybe this is why I cannot stop watching.\nMaybe the end is not what I fear\nbut what I have been waiting for—\nthe moment the curtain lifts\nand I finally understand\nwhich world I have been living in.'] },
    { n:'II',  title:'Entropy', etym:'the tendency of all closed systems toward disorder',
      stanzas:['A physicist told me once\nthat the universe is forgetting itself.\nSlowly. Evenly. With great patience.','Diseases, she said, are only molecules\nmisbehaving. The body is a borrowed\narrangement. Death, the cessation\nof a chemistry that was never ours\nto keep.','And yet.','My grandfather\'s voice was a chemistry.\nThe way he said my name on the porch\nwas a chemistry. The chicken sandwich,\nthe live stream, the cousin in his suit\nafter church—all of it, chemistry.','The second law says the heat will spread.\nThe cup of coffee on the desk\nwill cool to match the room.\nThe room will cool to match the house.\nThe house will cool to match the world.\nThe world will cool to match the dark.','This is the apocalypse no one televises.\nIt is happening now. It is happening\nin your hands, on this page,\nas the warmth of your fingers\nbleeds into the paper\nand the paper bleeds into the air\nand the air forgets, as it must,\nthat you were ever here.'] },
    { n:'III', title:'Nostalgia', etym:'Greek nostos (homecoming) + algos (pain)',
      stanzas:['Once, it was a diagnosis.\nSwiss mercenaries, in the lowlands\nof seventeenth-century France,\ndied of it. A fatal homesickness.\nDoctors prescribed leeches, opium,\na journey to higher ground.\nSome men were simply sent home\nto be cured or buried.','I think the word still kills.\nJust slower. Just quieter.','Last week I tried to remember\nthe sound of my grandfather\'s voice\nand could not. The word\ngrandfather\nwas a closed door. The word\nvoice\nwas a closed door. I had the keys\nand none of them fit.','There is no language for this:\nthe homesickness for a person\nwho is the home.','Somewhere in the word, a soldier\nis still dying of his fever,\ndreaming of the cowbells,\nthe angle of light through a window\nhis mother stood beside, once,\na long time ago,\ncalling him in for supper\nin a voice he can no longer hear.'] },
    { n:'IV',  title:'Apostasy', etym:'Greek apostasia: a standing-off',
      stanzas:['Not a slamming of the door.\nNot a renunciation, screamed.\nJust the small geometry\nof taking a step back—','the body, in its mute wisdom,\nunderstanding before the mind.','I asked my mother, when I was small,\nif the world would end.\nIf it happens, it happens,\nshe said. If we die, we die.','Mothers are supposed to lie\nabout these things. Aren\'t they?','In the pew, I watched my cousin\nmouth the words he no longer believed,\nand I understood, before I had the word,\nthat this is what most faith looks like:\nnot a leaving, but a standing-off,\na slow gradient of distance\nmeasured in unanswered prayers.','The Greek does not mean\nbetrayal.\nIt means: I was here, and now\nI am standing slightly farther away.\nIt means the cathedral is still beautiful\nfrom the field across the road.','The world did not end that night.\nIt kept spinning, and so did I,\nthough something in me had stepped back\nand refused, ever after, to come closer.'] },
    { n:'V',   title:'Palimpsest', etym:'a manuscript scraped clean and written over',
      stanzas:['In the medieval scriptoria,\nwhen parchment grew scarce,\nthe monks would scrape the old text\nfrom the page and write a new one\non top of it.','Sometimes, centuries later,\nunder ultraviolet light,\nthe older words rise up\nthrough the newer ones—','a Greek treatise\non the workings of the body,\nburied beneath\na book of psalms.','This is what I am, I think.\nThis is what we all are.','Cells in the body, I have read,\ndie and renew constantly.\nI am a walking palimpsest,\nrewritten with each heartbeat,\nthe old text faintly visible\nbeneath the new.','We cease to be and regenerate\na thousand times a day.\nHold the page to the light.\nYou will see them all.'] },
    { n:'VI',  title:'Genesis', etym:'Greek genesis: origin, the act of becoming',
      stanzas:['For every apocalypse, a beginning.\nThis is the part I keep forgetting.','The soil, stripped bare by greed,\nbegins to heal under patient hands.\nUrban gardens sprout from the skeletons\nof abandoned factories. The vine\nfinds the crack in the concrete\nand calls it home.','In the show I used to watch,\na brother\'s world ended\nthe night his sister was born.\nShe had to be hidden. The law\npermitted only one child.\nAnd so, in the moment of her arrival,\nthe life he had known dissolved—','his freedom, his quiet, his future.\nAll of it, gone. Replaced\nby the small, breathing weight\nof a person he would have to protect\nwith everything he was.','This is what I want to say:\nevery birth is a kind of ending.\nEvery ending, a birth in disguise.','The Greek root gen gives us generation,\ngenesis, generous, kin. It also gives us\ngene—the small, stubborn instruction\nthe body passes on, even in dying.','Even the molecules misbehaving\nare, in their way, still teaching\nthe next molecules what to do.'] },
    { n:'VII', title:'Present', etym:'Latin praesens: being at hand, standing before',
      stanzas:['The Polaroid develops in the palm.\nThe chemicals do their slow, bright work.\nAnd the moment it finishes,\nthe present is already the past.','There is no escape from the present.\nThis is the trick the word performs:\nit cannot be kept, only inhabited.\nIt cannot be saved, only spent.','I have spent so much of mine\nbracing. The asteroid. The wave.\nThe bright flash on the horizon.\nThe doomscroll at 2 a.m.,\ninoculating myself against a future\nI cannot, in any case, prevent.','And the small ones, too—\nthe histories erased,\nthe cultures dissolved into white noise,\nthe TikTok I forgot two scrolls ago,\nthe last note of a song\nI will never hear again,\nthe moment I forgot\nthe sound of my grandfather\'s voice.','Tiny deaths. Accumulating\nlike dust on forgotten bookshelves.','But here is the thing about dust:\nit is mostly the body. Mostly skin.\nMostly the small, particulate proof\nthat someone was here, and breathing,\nand is here, still, in this room,\non this page, in this present\nthat will not stop becoming the past.','Listen. Can you hear it?\n\nThe world is always ending.\nAnd it is always just about to begin.'] },
  ],
};

const SPREADS = [
  { l:{ t:'blank' },      r:{ t:'cover' } },
  { l:{ t:'preface' },    r:{ t:'poem', i:0 } },
  { l:{ t:'poem', i:1 },  r:{ t:'poem', i:2 } },
  { l:{ t:'poem', i:3 },  r:{ t:'poem', i:4 } },
  { l:{ t:'poem', i:5 },  r:{ t:'poem', i:6 } },
  { l:{ t:'end' },        r:{ t:'blank' } },
];

// ── Canvas-2D texture renderer ──────────────────────────────────────────────
const TEX_W = 512;
const TEX_H = Math.round(TEX_W * 1.55); // 793

// Wrap text, return final Y
function wrapText(
  ctx: CanvasRenderingContext2D,
  text: string, x: number, y: number, maxW: number, lh: number
): number {
  const words = text.split(' ');
  let line = '';
  for (const word of words) {
    const test = line ? line + ' ' + word : word;
    if (ctx.measureText(test).width > maxW && line) {
      ctx.fillText(line, x, y);
      y += lh;
      line = word;
    } else {
      line = test;
    }
  }
  if (line) { ctx.fillText(line, x, y); y += lh; }
  return y;
}

function drawPageToCanvas(
  ctx: CanvasRenderingContext2D,
  spec: { t: string; i?: number },
  side: 'l' | 'r',
  spreadIdx: number
): void {
  const W = TEX_W, H = TEX_H;
  const PAD = Math.round(W * 0.11);
  const SERIF = `'Fraunces Variable', 'Georgia', serif`;
  const MONO  = `'JetBrains Mono', 'Courier New', monospace`;

  // Background
  ctx.fillStyle = spec.t === 'cover' ? '#141210'
                : spec.t === 'blank' ? '#ede6d8'
                : '#f5efe3';
  ctx.fillRect(0, 0, W, H);

  // Ambient gradient (top light)
  const grad = ctx.createLinearGradient(0, 0, 0, H);
  grad.addColorStop(0, 'rgba(255,255,255,0.07)');
  grad.addColorStop(0.5, 'rgba(0,0,0,0)');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, W, H);

  if (spec.t === 'blank') return;

  if (spec.t === 'cover') {
    let y = Math.round(H * 0.14);
    // Rule
    ctx.fillStyle = '#c47a2e';
    ctx.fillRect(PAD, y, Math.round(W * 0.12), 1);
    y += Math.round(W * 0.07);
    // Title (two lines)
    ctx.fillStyle = '#f0e8d8';
    ctx.font = `400 ${Math.round(W * 0.155)}px ${SERIF}`;
    ctx.fillText('Small', PAD, y);
    y += Math.round(W * 0.165);
    ctx.fillText('Apocalypses', PAD, y);
    y += Math.round(W * 0.1);
    // Subtitle
    ctx.font = `${Math.round(W * 0.048)}px ${MONO}`;
    ctx.fillStyle = '#c47a2e';
    ctx.letterSpacing = '0.05em';
    wrapText(ctx, C.subtitle, PAD, y, W - PAD * 2, Math.round(W * 0.065));
    y += Math.round(W * 0.14);
    ctx.fillStyle = '#786858';
    ctx.font = `${Math.round(W * 0.042)}px ${MONO}`;
    ctx.fillText(C.count, PAD, y);
    // Author (bottom)
    ctx.fillText('Brandon Nguyen', PAD, H - PAD);
    return;
  }

  if (spec.t === 'preface') {
    let y = Math.round(H * 0.1);
    ctx.font = `${Math.round(W * 0.042)}px ${MONO}`;
    ctx.fillStyle = '#8a7c68';
    ctx.letterSpacing = '0.08em';
    ctx.fillText('PREFACE', PAD, y);
    y += Math.round(W * 0.09);
    ctx.letterSpacing = '0';
    ctx.fillStyle = '#1c1810';
    const lh = Math.round(W * 0.074);
    ctx.font = `italic ${Math.round(W * 0.052)}px ${SERIF}`;
    for (const para of C.preface) {
      y = wrapText(ctx, para, PAD, y, W - PAD * 2, lh);
      y += Math.round(W * 0.04);
      if (y > H * 0.88) break;
    }
    // Page number
    ctx.font = `${Math.round(W * 0.038)}px ${MONO}`;
    ctx.fillStyle = '#8a7c68';
    ctx.letterSpacing = '0.04em';
    const pn = spreadIdx * 2;
    if (pn > 0) ctx.fillText(String(pn), PAD, H - Math.round(W * 0.055));
    return;
  }

  if (spec.t === 'poem') {
    const p = C.poems[spec.i!];
    let y = Math.round(H * 0.09);
    // Number
    ctx.font = `${Math.round(W * 0.038)}px ${MONO}`;
    ctx.fillStyle = '#c47a2e';
    ctx.letterSpacing = '0.1em';
    ctx.fillText(p.n, PAD, y);
    y += Math.round(W * 0.065);
    // Title
    ctx.letterSpacing = '-0.01em';
    ctx.font = `400 ${Math.round(W * 0.115)}px ${SERIF}`;
    ctx.fillStyle = '#1c1810';
    ctx.fillText(p.title, PAD, y);
    y += Math.round(W * 0.115);
    // Etymology
    ctx.letterSpacing = '0';
    ctx.font = `italic ${Math.round(W * 0.042)}px ${SERIF}`;
    ctx.fillStyle = '#8a7c68';
    y = wrapText(ctx, p.etym, PAD, y, W - PAD * 2, Math.round(W * 0.054));
    y += Math.round(W * 0.04);
    // Rule
    ctx.fillStyle = '#c47a2e';
    ctx.fillRect(PAD, y - Math.round(W * 0.015), Math.round(W * 0.09), 1);
    y += Math.round(W * 0.045);
    // Stanzas
    ctx.fillStyle = '#1c1810';
    ctx.font = `${Math.round(W * 0.05)}px ${SERIF}`;
    const lh2 = Math.round(W * 0.068);
    for (const stanza of p.stanzas) {
      for (const line of stanza.split('\n')) {
        if (line === '') { y += Math.round(W * 0.025); continue; }
        y = wrapText(ctx, line, PAD, y, W - PAD * 2, lh2);
      }
      y += Math.round(W * 0.04);
      if (y > H * 0.9) break;
    }
    // Scroll fade at bottom (for overflowing content)
    const fadeGrad = ctx.createLinearGradient(0, H * 0.8, 0, H * 0.95);
    fadeGrad.addColorStop(0, 'rgba(245,239,227,0)');
    fadeGrad.addColorStop(1, 'rgba(245,239,227,1)');
    ctx.fillStyle = fadeGrad;
    ctx.fillRect(0, H * 0.8, W, H * 0.15);
    // Page number
    const pn = spreadIdx * 2 + (side === 'l' ? 0 : 1);
    if (pn > 0 && pn < SPREADS.length * 2 - 1) {
      ctx.font = `${Math.round(W * 0.038)}px ${MONO}`;
      ctx.fillStyle = '#8a7c68';
      ctx.letterSpacing = '0.04em';
      if (side === 'l') {
        ctx.fillText(String(pn), PAD, H - Math.round(W * 0.055));
      } else {
        ctx.textAlign = 'right';
        ctx.fillText(String(pn), W - PAD, H - Math.round(W * 0.055));
        ctx.textAlign = 'left';
      }
    }
    return;
  }

  if (spec.t === 'end') {
    const cx = W / 2;
    const cy = H / 2;
    ctx.fillStyle = '#8a7c68';
    ctx.fillRect(cx - Math.round(W * 0.06), cy - Math.round(W * 0.07), Math.round(W * 0.12), 1);
    ctx.font = `${Math.round(W * 0.042)}px ${MONO}`;
    ctx.fillStyle = '#8a7c68';
    ctx.letterSpacing = '0.12em';
    ctx.textAlign = 'center';
    ctx.fillText('FINIS', cx, cy);
    ctx.fillRect(cx - Math.round(W * 0.06), cy + Math.round(W * 0.03), Math.round(W * 0.12), 1);
    ctx.font = `italic ${Math.round(W * 0.048)}px ${SERIF}`;
    ctx.letterSpacing = '0';
    ctx.fillText(C.title, cx, cy + Math.round(W * 0.1));
    ctx.textAlign = 'left';
    return;
  }
}

function makeCanvasTexture(spec: { t: string; i?: number }, side: 'l' | 'r', si: number): THREE.CanvasTexture {
  const cv = document.createElement('canvas');
  cv.width = TEX_W;
  cv.height = TEX_H;
  const ctx = cv.getContext('2d')!;
  drawPageToCanvas(ctx, spec, side, si);
  const tex = new THREE.CanvasTexture(cv);
  tex.minFilter = THREE.LinearFilter;
  tex.magFilter = THREE.LinearFilter;
  return tex;
}

// ── Shaders ─────────────────────────────────────────────────────────────────
const vertexShader = /* glsl */`
  // Conical developable surface page flip.
  // The leaf is in local coordinates: x ∈ [0,1], y ∈ [-0.775, 0.775].
  // cornerPos is the current position of the dragged bottom-right corner.

  uniform vec2  cornerPos;   // current corner position in scene space
  uniform float flipSign;    // +1 = forward (right→left), -1 = backward (left→right)

  varying vec2  vUv;
  varying float vHeight;     // z lift for shading
  varying float vDistFold;   // signed distance from fold line (for AO)

  void main() {
    vUv = uv;

    // Rest corner of this leaf (bottom-right in scene space for forward flip)
    vec2 restCorner = vec2(flipSign * 1.0, -0.775);
    vec2 corner = cornerPos;

    vec2 drag = corner - restCorner;
    float dragLen = length(drag);

    vec3 pos = position;
    vHeight = 0.0;
    vDistFold = 0.0;

    if (dragLen > 0.001) {
      // Fold line = perpendicular bisector of restCorner → corner
      vec2 mid = 0.5 * (restCorner + corner);
      vec2 foldN = -normalize(drag);         // negated: d>0 selects the "being lifted" side
      vec2 foldT = vec2(-foldN.y, foldN.x); // tangent along fold line

      vec2 toV = position.xy - mid;
      float d  = dot(toV, foldN);  // signed distance from fold line
      float t  = dot(toV, foldT);  // position along fold line

      vDistFold = d;

      if (d > 0.0) {
        // This vertex is on the "lifted" side.
        // Cone taper: radius of curvature grows away from the dragged corner.
        // The drag corner is at (corner - mid) projected onto foldT.
        float cornerAlong = dot(corner - mid, foldT);
        float fromCorner  = abs(t - cornerAlong);
        float R = max(0.025, 0.045 + fromCorner * 0.28);

        float angle = min(d / R, 3.14159265);

        // Map vertex: rotate arc around fold line
        vec2 base = position.xy - d * foldN;
        pos.xy = base + R * sin(angle) * foldN;
        pos.z  = R * (1.0 - cos(angle));
      }
    }

    vHeight = pos.z;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
  }
`;

const fragmentShader = /* glsl */`
  uniform sampler2D frontTex;
  uniform sampler2D backTex;

  varying vec2  vUv;
  varying float vHeight;
  varying float vDistFold;

  void main() {
    vec4 color;
    float brightness = 1.0;

    if (gl_FrontFacing) {
      color = texture2D(frontTex, vUv);
    } else {
      // Mirror U for back face, dim 20%
      color = texture2D(backTex, vec2(1.0 - vUv.x, vUv.y));
      brightness = 0.80;
    }

    // Blinn-Phong sheen at curl peak
    float sheen = pow(clamp(vHeight * 2.8, 0.0, 1.0), 2.2) * 0.22;

    // Ambient occlusion near fold crease
    float ao = 0.82 + 0.18 * clamp(vHeight * 9.0, 0.0, 1.0);

    // Cast shadow from lifted leaf onto page below (darkens the base page region)
    // approximated by AO above; actual shadow is on the shadow plane mesh

    vec3 lit = color.rgb * brightness * ao + sheen;
    gl_FragColor = vec4(lit, color.a);
  }
`;

// Shadow plane shaders (simple gradient darkening under the curl)
const shadowVert = /* glsl */`
  varying vec2 vUv;
  void main() {
    vUv = uv;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;
const shadowFrag = /* glsl */`
  uniform float strength;
  uniform float foldX;    // x position of fold axis (0..1 in shadow UV space)
  varying vec2 vUv;
  void main() {
    // Shadow is strongest just to the right of the fold and fades
    float d = vUv.x - foldX;
    float alpha = strength * clamp(1.0 - d * 4.0, 0.0, 1.0) * clamp(d * 8.0, 0.0, 1.0);
    gl_FragColor = vec4(0.0, 0.0, 0.0, alpha);
  }
`;

// ── Audio ───────────────────────────────────────────────────────────────────
let _audioCtx: AudioContext | null = null;
function getCtx() {
  const Ctor = (window.AudioContext || (window as any).webkitAudioContext) as typeof AudioContext;
  if (!Ctor) return null;
  if (!_audioCtx) _audioCtx = new Ctor();
  return _audioCtx;
}
function playFlip(forward: boolean) {
  try {
    const ctx = getCtx(); if (!ctx) return;
    const go = () => {
      const dur = 0.36;
      const buf = ctx.createBuffer(1, ctx.sampleRate * dur, ctx.sampleRate);
      const d = buf.getChannelData(0);
      for (let i = 0; i < d.length; i++) d[i] = Math.random() * 2 - 1;
      const src = ctx.createBufferSource(); src.buffer = buf;
      const bp = ctx.createBiquadFilter(); bp.type = 'bandpass';
      bp.frequency.setValueAtTime(forward ? 3200 : 1800, ctx.currentTime);
      bp.frequency.exponentialRampToValueAtTime(forward ? 700 : 400, ctx.currentTime + 0.26);
      bp.Q.value = 0.7;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0, ctx.currentTime);
      g.gain.linearRampToValueAtTime(0.9, ctx.currentTime + 0.016);
      g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + dur);
      src.connect(bp); bp.connect(g); g.connect(ctx.destination);
      src.start();
    };
    ctx.state === 'suspended' ? ctx.resume().then(go) : go();
  } catch {}
}

// ── Main book controller ─────────────────────────────────────────────────────
function initBook() {
  const canvas  = document.getElementById('book-canvas') as HTMLCanvasElement;
  const dotsRow = document.getElementById('dots-row')!;
  const hint    = document.getElementById('flip-hint') as HTMLParagraphElement;

  if (!canvas) return;

  // ── Sizing helper ─────────────────────────────────────────────────────────
  function computePageW() {
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const isMobile = vw <= 600;
    if (isMobile) return Math.min(vw - 32, 320);
    return Math.max(240, Math.min(vw * 0.37, (vh - 160) / 1.55, 490));
  }

  let pageW = computePageW();
  let pageH = pageW * 1.55;
  const isMobile = () => window.innerWidth <= 600;

  // ── Three.js setup ────────────────────────────────────────────────────────
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(window.devicePixelRatio);

  // Scene is always 2 × 1.55 units (or 1 × 1.55 on mobile)
  // We use an orthographic camera that exactly fits this rect.
  const SCENE_HALF_W = 1.0; // half-width (each page = 1 unit, two pages = 2 wide)
  const SCENE_HALF_H = 0.775;

  const camera = new THREE.OrthographicCamera(
    -SCENE_HALF_W, SCENE_HALF_W,
     SCENE_HALF_H, -SCENE_HALF_H,
    0.001, 100
  );
  camera.position.z = 5;

  const scene = new THREE.Scene();

  function resize() {
    pageW = computePageW();
    pageH = pageW * 1.55;
    const mobile = isMobile();
    const cw = mobile ? pageW : pageW * 2;
    const ch = pageH;
    canvas.style.width  = cw + 'px';
    canvas.style.height = ch + 'px';
    renderer.setSize(cw, ch, false);
    const hw = mobile ? 0.5 : 1.0;
    camera.left   = -hw; camera.right  = hw;
    camera.top    = SCENE_HALF_H; camera.bottom = -SCENE_HALF_H;
    camera.updateProjectionMatrix();
  }
  resize();

  // ── Textures ──────────────────────────────────────────────────────────────
  // Pre-render all spread textures
  const textures: Array<{ l: THREE.CanvasTexture; r: THREE.CanvasTexture }> =
    SPREADS.map((s, i) => ({
      l: makeCanvasTexture(s.l, 'l', i),
      r: makeCanvasTexture(s.r, 'r', i),
    }));

  // ── Static page meshes ────────────────────────────────────────────────────
  // Left page: x ∈ [-1, 0], Right page: x ∈ [0, 1]
  const pageGeo = new THREE.PlaneGeometry(1.0, 1.55);

  const leftMat  = new THREE.MeshBasicMaterial({ map: textures[0].l, side: THREE.FrontSide });
  const rightMat = new THREE.MeshBasicMaterial({ map: textures[0].r, side: THREE.FrontSide });
  const leftMesh  = new THREE.Mesh(pageGeo, leftMat);
  const rightMesh = new THREE.Mesh(pageGeo, rightMat);
  leftMesh.position.x  = -0.5;
  rightMesh.position.x =  0.5;
  leftMesh.position.z  = 0.001;
  rightMesh.position.z = 0.001;
  scene.add(leftMesh, rightMesh);

  // Spine line
  const spineGeo = new THREE.PlaneGeometry(0.003, 1.55);
  const spineMat = new THREE.MeshBasicMaterial({ color: 0x8a7c68, opacity: 0.35, transparent: true });
  scene.add(new THREE.Mesh(spineGeo, spineMat));

  // Drop shadow behind book
  const shadowGeo = new THREE.PlaneGeometry(2.0, 1.55);
  const shadowMat = new THREE.ShaderMaterial({
    uniforms: { strength: { value: 0 }, foldX: { value: 0.5 } },
    vertexShader: shadowVert,
    fragmentShader: shadowFrag,
    transparent: true,
    depthWrite: false,
  });
  const shadowMesh = new THREE.Mesh(shadowGeo, shadowMat);
  shadowMesh.position.z = 0.0005;
  scene.add(shadowMesh);

  // ── Leaf mesh (conical flip geometry) ─────────────────────────────────────
  // Two geometries: forward (right page, x:0→1) and backward (left page, x:-1→0).
  // No scale mirroring — coordinate spaces match scene space cleanly.
  const leafGeoFwd = new THREE.PlaneGeometry(1.0, 1.55, 60, 40);
  leafGeoFwd.translate(0.5, 0, 0);   // spine at x=0, right edge at x=1

  const leafGeoBwd = new THREE.PlaneGeometry(1.0, 1.55, 60, 40);
  leafGeoBwd.translate(-0.5, 0, 0);  // spine at x=0, left edge at x=-1

  const leafUniforms = {
    frontTex:  { value: textures[0].r },
    backTex:   { value: textures[1].l },
    cornerPos: { value: new THREE.Vector2(1.0, -0.775) },
    flipSign:  { value: 1.0 },
  };
  const leafMat = new THREE.ShaderMaterial({
    uniforms: leafUniforms,
    vertexShader,
    fragmentShader,
    side: THREE.DoubleSide,
    transparent: false,
  });
  const leafMesh = new THREE.Mesh(leafGeoFwd, leafMat);
  leafMesh.position.z = 0.002;
  leafMesh.visible = false;
  scene.add(leafMesh);

  // ── Spread state ──────────────────────────────────────────────────────────
  let current = 0;

  function showSpread(idx: number) {
    leftMat.map  = textures[idx].l;
    rightMat.map = textures[idx].r;
    leftMat.needsUpdate  = true;
    rightMat.needsUpdate = true;
    dotsRow.querySelectorAll('.dot').forEach((d, i) =>
      d.setAttribute('aria-selected', i === idx ? 'true' : 'false')
    );
    // Hide/show pages on mobile (single page: show right only)
    if (isMobile()) {
      leftMesh.visible  = false;
      rightMesh.visible = true;
    } else {
      leftMesh.visible  = true;
      rightMesh.visible = true;
    }
  }

  // ── Spring physics ────────────────────────────────────────────────────────
  // Corner tracks from restX → targetX along x-axis.
  // restX = 1.0 (right), targetX = -1.0 (flipped left) for forward.
  const K  = 140; // stiffness  — softer so the snap feels weighted
  const Cv = 32;  // damping    — overdamped (critical ≈ 2√140 ≈ 23.7), no bounce

  let flip = {
    active:    false,
    dir:       1 as 1 | -1,   // 1=forward, -1=backward
    cornerX:   1.0,
    cornerVel: 0.0,
    targetX:   1.0,
    dragging:  false,
    dragStart: 0,              // x at drag start (scene space)
    pending:   1,              // spread we're flipping to
    committed: false,          // have we already committed the new spread?
  };

  let lastTime = 0;
  let rafId = 0;
  let needsRender = true;

  function beginFlip(dir: 1 | -1) {
    if (flip.active) return;
    const next = current + dir;
    if (next < 0 || next >= SPREADS.length) return;

    flip.active    = true;
    flip.dir       = dir;
    flip.pending   = next;
    flip.committed = false;
    flip.cornerX   = dir === 1 ? 1.0 : -1.0;
    flip.cornerVel = 0;
    flip.targetX   = dir === 1 ? -1.0 : 1.0;

    // Set leaf uniforms
    leafUniforms.flipSign.value = dir;
    if (dir === 1) {
      leafMesh.geometry           = leafGeoFwd;  // x: 0→1  (right page)
      leafUniforms.frontTex.value = textures[current].r;
      leafUniforms.backTex.value  = textures[next].l;
      leafMesh.position.x         = 0;
      leafMesh.scale.x            = 1;
      rightMesh.visible           = false;
    } else {
      leafMesh.geometry           = leafGeoBwd;  // x: -1→0 (left page)
      leafUniforms.frontTex.value = textures[current].l;
      leafUniforms.backTex.value  = textures[next].r;
      leafMesh.position.x         = 0;
      leafMesh.scale.x            = 1;
      leftMesh.visible            = false;
    }
    leafMesh.visible = true;
    playFlip(dir === 1);
    needsRender = true;
  }

  function snapTo(committed: boolean) {
    if (!flip.active || flip.dragging) return;
    // If past center, commit to target; else snap back.
    const mid = (flip.dir === 1) ? 0.0 : 0.0;
    if (committed || (flip.dir === 1 ? flip.cornerX < mid : flip.cornerX > mid)) {
      flip.targetX = flip.dir === 1 ? -1.0 : 1.0;
    } else {
      flip.targetX = flip.dir === 1 ? 1.0 : -1.0;
    }
    needsRender = true;
  }

  function updateFlip(dt: number) {
    if (!flip.active || flip.dragging) return;

    const force = -K * (flip.cornerX - flip.targetX) - Cv * flip.cornerVel;
    flip.cornerVel += force * dt;
    flip.cornerX   += flip.cornerVel * dt;

    // Commit spread at midpoint (when back face is showing)
    if (!flip.committed) {
      const mid = 0.0;
      if ((flip.dir === 1 && flip.cornerX < mid) || (flip.dir === -1 && flip.cornerX > mid)) {
        flip.committed = true;
        current = flip.pending;
        // Update the static pages to the new spread
        if (flip.dir === 1) leftMat.map  = textures[current].l;
        else                rightMat.map = textures[current].r;
        leftMat.needsUpdate  = true;
        rightMat.needsUpdate = true;
        dotsRow.querySelectorAll('.dot').forEach((d, i) =>
          d.setAttribute('aria-selected', i === current ? 'true' : 'false')
        );
      }
    }

    // During snap, ease corner Y back to rest (-0.775)
    const snapProgress = Math.abs(flip.cornerX - flip.targetX) / 2.0;
    const cornerY = -0.775 + (leafUniforms.cornerPos.value.y + 0.775) * snapProgress;
    leafUniforms.cornerPos.value.set(flip.cornerX, Math.min(-0.2, cornerY));

    const restX   = flip.dir === 1 ? 1.0 : -1.0;
    const progress = Math.abs(flip.cornerX - restX) / 2.0;
    shadowMat.uniforms.strength.value = Math.sin(progress * Math.PI) * 0.22;
    shadowMat.uniforms.foldX.value    = (flip.cornerX + 1.0) / 2.0;

    // Settled?
    if (Math.abs(flip.cornerX - flip.targetX) < 0.003 && Math.abs(flip.cornerVel) < 0.01) {
      flip.cornerX = flip.targetX;
      flip.active  = false;
      leafMesh.visible = false;
      rightMesh.visible = true;
      leftMesh.visible  = !isMobile();
      shadowMat.uniforms.strength.value = 0;
      // Ensure correct spread if we snapped BACK
      if (!flip.committed) {
        dotsRow.querySelectorAll('.dot').forEach((d, i) =>
          d.setAttribute('aria-selected', i === current ? 'true' : 'false')
        );
      }
    }
  }

  // ── Render loop ───────────────────────────────────────────────────────────
  function loop(ts: number) {
    rafId = requestAnimationFrame(loop);
    const dt = Math.min((ts - lastTime) / 1000, 0.05);
    lastTime = ts;

    if (flip.active) {
      updateFlip(dt);
      needsRender = true;
    }

    if (needsRender) {
      renderer.render(scene, camera);
      needsRender = false;
    }
  }
  rafId = requestAnimationFrame((ts) => { lastTime = ts; loop(ts); });

  // ── Dots nav ──────────────────────────────────────────────────────────────
  SPREADS.forEach((_, i) => {
    const dot = document.createElement('button');
    dot.className = 'dot';
    dot.setAttribute('role', 'tab');
    dot.setAttribute('aria-label', `Spread ${i + 1} of ${SPREADS.length}`);
    dot.setAttribute('aria-selected', i === 0 ? 'true' : 'false');
    dot.addEventListener('click', () => {
      if (i === current || flip.active) return;
      if (Math.abs(i - current) === 1) {
        beginFlip(i > current ? 1 : -1);
        snapTo(true);
      } else {
        current = i;
        showSpread(current);
        needsRender = true;
      }
    });
    dotsRow.appendChild(dot);
  });

  showSpread(0);

  // ── Pointer interaction ───────────────────────────────────────────────────
  let pointerDown  = false;
  let pointerStartX = 0;
  let pointerStartY = 0;

  // Convert client coords → scene space (-1..1 x, -0.775..0.775 y)
  function toScene(clientX: number, clientY: number) {
    const rect = canvas.getBoundingClientRect();
    const nx = (clientX - rect.left) / rect.width;
    const ny = (clientY - rect.top)  / rect.height;
    return {
      sx: (nx * 2 - 1),
      sy: (1 - ny * 2) * 0.775,
    };
  }

  // Corner hotspot: bottom-outer ~30% of each page.
  // Returns the flip direction if the pointer is in a draggable corner, else null.
  function cornerDir(clientX: number, clientY: number): 1 | -1 | null {
    const { sx, sy } = toScene(clientX, clientY);
    const mobile = isMobile();
    // Bottom portion of the page only
    if (sy > -0.22) return null;
    if (mobile) {
      // Single-page: only right corner (always forward)
      return sx > 0.35 ? 1 : null;
    }
    // Two-page: right corner → forward, left corner → backward
    if (sx >  0.52) return 1;
    if (sx < -0.52) return -1;
    return null;
  }

  canvas.addEventListener('pointermove', (e) => {
    if (pointerDown || flip.active) return;
    const dir = cornerDir(e.clientX, e.clientY);
    // Show a grab cursor over draggable corners only
    if (dir === 1 && current < SPREADS.length - 1)      canvas.style.cursor = 'grab';
    else if (dir === -1 && current > 0)                  canvas.style.cursor = 'grab';
    else                                                  canvas.style.cursor = 'default';
  });

  canvas.addEventListener('pointerdown', (e) => {
    if (flip.active) return;
    const dir = cornerDir(e.clientX, e.clientY);
    if (!dir) return;
    const next = current + dir;
    if (next < 0 || next >= SPREADS.length) return;

    canvas.setPointerCapture(e.pointerId);
    canvas.style.cursor = 'grabbing';
    pointerDown   = true;
    pointerStartX = e.clientX;
    pointerStartY = e.clientY;

    beginFlip(dir);
    flip.dragging  = true;
    hint.style.opacity = '0';
  });

  canvas.addEventListener('pointermove', (e) => {
    if (!pointerDown || !flip.active || !flip.dragging) return;

    const rect  = canvas.getBoundingClientRect();
    const pageW = isMobile() ? rect.width : rect.width / 2;

    const dx      = (e.clientX - pointerStartX) / pageW;
    const startCX = flip.dir === 1 ? 1.0 : -1.0;

    // Clamp strictly to [−1, 1] so page can't fold outward past the spine
    flip.cornerX = Math.max(-1.0, Math.min(1.0, startCX + dx));

    // Corner Y tracks the mouse — keeps the fold diagonal and realistic
    const { sy } = toScene(e.clientX, e.clientY);
    const cornerY = Math.max(-0.775, Math.min(-0.15, sy));

    leafUniforms.cornerPos.value.set(flip.cornerX, cornerY);

    const progress = Math.abs(flip.cornerX - startCX) / 2.0;
    shadowMat.uniforms.strength.value = Math.sin(Math.min(progress, 1) * Math.PI) * 0.2;
    shadowMat.uniforms.foldX.value    = (flip.cornerX + 1.0) / 2.0;
    needsRender = true;
  });

  canvas.addEventListener('pointerup', (e) => {
    if (!pointerDown) return;
    pointerDown  = false;
    flip.dragging = false;
    canvas.style.cursor = 'default';

    const rect  = canvas.getBoundingClientRect();
    const pageW = isMobile() ? rect.width : rect.width / 2;
    const totalDx = e.clientX - pointerStartX;

    // Commit if: dragged past 30% of page width in correct direction,
    // OR released with enough velocity toward the destination.
    const draggedFar  = (flip.dir === 1 ? -totalDx : totalDx) > pageW * 0.30;
    const fastRelease = (flip.dir === 1 ? -flip.cornerVel : flip.cornerVel) > 0.8;
    snapTo(draggedFar || fastRelease);
  });

  // ── Keyboard ──────────────────────────────────────────────────────────────
  function keyFlip(dir: 1 | -1) {
    if (flip.active) return;
    beginFlip(dir);
    snapTo(true);
  }
  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') keyFlip(1);
    if (e.key === 'ArrowLeft')  keyFlip(-1);
  });

  // ── Resize ────────────────────────────────────────────────────────────────
  window.addEventListener('resize', () => {
    resize();
    needsRender = true;
  });

  // ── Cleanup on page transition ────────────────────────────────────────────
  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(rafId);
    renderer.dispose();
  });
}

document.addEventListener('astro:page-load', initBook);
</script>
