---
import Base from '@/layouts/Base.astro';
---

<Base
  title="About — Brandon Nguyen"
  description="Neuroscience student at UVA. Writing about the brain, medicine, and things in between."
>
  <div class="about-wrap">
    <header class="about-header">
      <h1 class="about-title">About</h1>
    </header>

    <div class="prose about-prose">
      <p>Still learning about myself.</p>
    </div>
  </div>
</Base>

<style>
  .about-wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) clamp(1.5rem, 5vw, 4rem) 8rem;
  }

  .about-header {
    margin-bottom: 3rem;
  }

  .about-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-variation-settings: 'opsz' 72;
    font-weight: 400;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin: 0;
  }

  .about-prose {
    font-size: 1.125rem;
  }
</style>
